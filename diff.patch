+      batchJobId: completion.batchJobId,
+      status: 'failed',
+    });
+    await this.handleListPackages();
+
+    await this.resumeGraph({
+      completed: false,
+      error: message,
+    } as BatchPendingResume);
+  };
+
+  dispose(): void {
+    this.batchPoller.dispose();
+    super.dispose();
   }
 }
