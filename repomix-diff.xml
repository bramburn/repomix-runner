);

CREATE INDEX IF NOT EXISTS idx_memory_scope ON chat_memory(scope, scope_id);

-- Batch jobs (for Batch LLM Pipeline - PRD 005)
CREATE TABLE IF NOT EXISTS batch_jobs (
