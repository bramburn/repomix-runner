{
  "publisher": "bramburn",
  "name": "repomix-runner-plus",
  "main": "./dist/extension.js",
  "displayName": "Repomix Runner Plus",
  "icon": "assets/repomix-logo.png",
  "description": "Easily bundle files into a single output for AI processing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bramburn/repomix-runner.git"
  },
  "version": "1.0.28",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onCommand:repomixRunner.run",
    "onCommand:repomixRunner.runOnOpenFiles",
    "onCommand:repomixRunner.openSettings",
    "onCommand:repomixRunner.openOutput",
    "onCommand:repomixRunner.testCompression",
    "onCommand:repomixRunner.smartRun",
    "onCommand:repomixRunner.copySelectedFilesAsCompressed",
    "onView:repomixBundles",
    "onView:repomixRunner.controlPanel",
    "onView:repomixRunner.aiChatMain",
    "onCommand:repomixRunner.copyAllGitChanges",
    "onCommand:repomixRunner.testPostgresConnection",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Runner",
        "order": 1,
        "type": "object",
        "properties": {
          "repomix.runner.keepOutputFile": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": " 📌 \n Keep the output file after copying its content to clipboard"
          },
          "repomix.runner.copyMode": {
            "order": 3,
            "type": "string",
            "enum": [
              "content",
              "file"
            ],
            "default": "content",
            "description": "✍️ or 💾 \n Choose what to copy to clipboard: 'content' for text content, 'file' for the file itself"
          },
          "repomix.runner.useTargetAsOutput": {
            "order": 2,
            "type": "boolean",
            "default": false,
            "description": "🎯 ➡️  🎯 \n Use the targetted folder as the output folder"
          },
          "repomix.runner.useBundleNameAsOutputName": {
            "order": 4,
            "type": "boolean",
            "default": true,
            "description": "📝 \n Use bundle name as output file name when running a bundle"
          },
          "repomix.runner.verbose": {
            "order": 5,
            "type": "boolean",
            "default": false,
            "description": "🔍 \n Verbose mode"
          },
          "repomix.runner.configPath": {
            "order": 6,
            "type": "string",
            "default": "",
            "description": "📁 \n Custom path to the configuration file (relative to workspace root)"
          }
        }
      },
      {
        "title": "Enrichment",
        "order": 4,
        "type": "object",
        "properties": {
          "repomix.enrichment.enabled": {
            "order": 1,
            "type": "boolean",
            "default": false,
            "description": "🔋 \n Toggle code enrichment during compression"
          },
          "repomix.enrichment.llmProvider": {
            "order": 2,
            "type": "string",
            "enum": ["gemini", "ollama", "lmstudio", "openrouter"],
            "default": "gemini",
            "description": "🤖 \n LLM provider for generating enrichments"
          }
        }
      },
      {
        "title": "Output",
        "order": 2,
        "type": "object",
        "properties": {
          "repomix.output.filePath": {
            "order": 1,
            "type": "string",
            "default": "repomix-output.xml",
            "description": "⚙️ ➡️ ❓\n Path to the output file"
          },
          "repomix.output.style": {
            "order": 2,
            "type": "string",
            "enum": [
              "plain",
              "xml",
              "markdown",
              "json"
            ],
            "default": "xml",
            "description": "🎨 \n Output format style"
          },
          "repomix.output.parsableStyle": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "description": "✂️ \n - Ensures output strictly follows the specification of the chosen format. \n - Provides properly escaped XML output with fast-xml-parser.\n - Dynamically adjusts markdown code block delimiters to avoid content conflicts. \n - Note that this option can increase token count."
          },
          "repomix.output.headerText": {
            "order": 4,
            "type": "string",
            "default": "",
            "description": "📝\n Add a header text to the output"
          },
          "repomix.output.fileSummary": {
            "order": 5,
            "type": "boolean",
            "default": true,
            "description": "➕📝\n Include file summary in output"
          },
          "repomix.output.removeEmptyLines": {
            "order": 6,
            "type": "boolean",
            "default": false,
            "description": "🧹 \n Remove empty lines from code"
          },
          "repomix.output.includeEmptyDirectories": {
            "order": 7,
            "type": "boolean",
            "default": false,
            "description": "🧹 \n Include empty directories in output"
          },
          "repomix.output.instructionFilePath": {
            "type": "string",
            "default": "",
            "description": "🫡\n Path to a file containing detailed custom instructions "
          },
          "repomix.output.directoryStructure": {
            "type": "boolean",
            "default": true,
            "description": "➕🌳 \n Include directory tree structure in output"
          },
          "repomix.output.removeComments": {
            "type": "boolean",
            "default": false,
            "description": "💬 ❌  \n Remove comments from code"
          },
          "repomix.output.copyToClipboard": {
            "type": "boolean",
            "default": true,
            "description": "🔗 \n Copy output to clipboard"
          },
          "repomix.output.topFilesLength": {
            "type": "number",
            "default": 5,
            "description": "Number of top files to show"
          },
          "repomix.output.showLineNumbers": {
            "type": "boolean",
            "default": false,
            "description": "🔢 \n Show line numbers in output"
          },
          "repomix.output.compress": {
            "order": 8,
            "type": "boolean",
            "default": false,
            "description": "🧠 \n Perform intelligent code extraction, focusing on essential function and class signatures to reduce token count"
          }
        }
      },
      {
        "title": "Include",
        "order": 3,
        "type": "object",
        "properties": {
          "repomix.include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "🔍 \n Patterns to include in processing"
          }
        }
      },
      {
        "title": "Ignore",
        "order": 4,
        "type": "object",
        "properties": {
          "repomix.ignore.useGitignore": {
            "type": "boolean",
            "default": true,
            "description": "Use .gitignore patterns"
          },
          "repomix.ignore.useDefaultPatterns": {
            "type": "boolean",
            "default": true,
            "description": "Use default ignore patterns"
          },
          "repomix.ignore.customPatterns": {
            "order": 6,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "🙈 \n Custom patterns to ignore"
          }
        }
      },
      {
        "title": "Security",
        "order": 5,
        "type": "object",
        "properties": {
          "repomix.security.enableSecurityCheck": {
            "type": "boolean",
            "default": true,
            "description": "🔒 \n Enable security check during processing"
          }
        }
      },
      {
        "title": "Token Count",
        "order": 6,
        "type": "object",
        "properties": {
          "repomix.tokenCount.encoding": {
            "type": "string",
            "enum": [
              "o200k_base",
              "cl100k_base",
              "p50k_edit",
              "p50k_base",
              "r50k_base",
              "gpt2"
            ],
            "default": "o200k_base",
            "description": "🔢 \n Token count encoding"
          }
        }
      },
      {
        "title": "LLM Providers",
        "order": 7,
        "type": "object",
        "properties": {
          "repomix.llm.defaultProvider": {
            "order": 1,
            "type": "string",
            "enum": [
              "gemini",
              "openrouter",
              "ollama",
              "lmstudio"
            ],
            "default": "gemini",
            "description": "⚙️ \n Default LLM provider for text generation"
          },
          "repomix.llm.embeddingProvider": {
            "order": 2,
            "type": "string",
            "enum": [
              "gemini",
              "openrouter",
              "ollama",
              "lmstudio"
            ],
            "default": "gemini",
            "description": "📊 \n Default provider for embeddings"
          },
          "repomix.llm.rateLimit.enabled": {
            "order": 3,
            "type": "boolean",
            "default": true,
            "description": "🛡️ \n Enable automatic rate limiting across all providers"
          },
          "repomix.llm.usageTracking.enabled": {
            "order": 4,
            "type": "boolean",
            "default": true,
            "description": "📈 \n Track API usage, tokens, and estimated costs"
          },
          "repomix.llm.gemini.apiKey": {
            "order": 10,
            "type": "string",
            "default": "",
            "description": "🔑 \n Google Gemini API key"
          },
          "repomix.llm.gemini.model": {
            "order": 11,
            "type": "string",
            "default": "gemini-2.5-flash-lite",
            "description": "📦 \n Default Gemini model"
          },
          "repomix.llm.gemini.rpm": {
            "order": 12,
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 60,
            "description": "⏱️ \n Requests per minute limit (free tier: 10)"
          }
        }
      },
      {
        "title": "Embedding",
        "order": 8,
        "type": "object",
        "properties": {
          "repomix.embedding.provider": {
            "order": 1,
            "type": "string",
            "enum": [
              "gemini",
              "ollama",
              "lmstudio",
              "openrouter"
            ],
            "default": "gemini",
            "description": "🤖 \n Embedding provider to use"
          },
          "repomix.ollama.url": {
            "order": 2,
            "type": "string",
            "default": "http://localhost:11434",
            "description": "🌐 \n Ollama API URL"
          },
          "repomix.ollama.model": {
            "order": 3,
            "type": "string",
            "default": "nomic-embed-text",
            "description": "📦 \n Ollama embedding model name"
          },
          "repomix.ollama.dimension": {
            "order": 4,
            "type": "number",
            "default": 768,
            "description": "📏 \n Embedding dimension size"
          },
          "repomix.lmstudio.baseUrl": {
            "order": 5,
            "type": "string",
            "default": "http://localhost:1234/v1",
            "description": "🌐 \n LM Studio API base URL (e.g., http://localhost:1234/v1)"
          },
          "repomix.lmstudio.apiKey": {
            "order": 6,
            "type": "string",
            "default": "",
            "description": "🔑 \n LM Studio API key (optional, can be left blank)"
          },
          "repomix.lmstudio.model": {
            "order": 7,
            "type": "string",
            "default": "",
            "description": "📦 \n LM Studio embedding model name"
          },
          "repomix.lmstudio.dimension": {
            "order": 8,
            "type": "number",
            "default": 768,
            "description": "📏 \n LM Studio embedding dimension size"
          },
          "repomix.openrouter.baseUrl": {
            "order": 9,
            "type": "string",
            "default": "https://openrouter.ai/api/v1",
            "description": "🌐 \n OpenRouter API base URL"
          },
          "repomix.openrouter.model": {
            "order": 10,
            "type": "string",
            "default": "openai/text-embedding-3-small",
            "description": "📦 \n OpenRouter embedding model name (use 'Fetch Models' button to see available embedding models)"
          },
          "repomix.openrouter.dimension": {
            "order": 11,
            "type": "number",
            "default": 1536,
            "description": "📏 \n OpenRouter embedding dimension size (text-embedding-3-small: 1536, text-embedding-3-large: 3072)"
          },
          "repomix.openrouter.providerOrder": {
            "order": 12,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "nebius"
            ],
            "description": "🔀 \n Provider routing order (e.g., [\"nebius\"])"
          },
          "repomix.openrouter.allowFallbacks": {
            "order": 13,
            "type": "boolean",
            "default": true,
            "description": "🔄 \n Allow fallback to other providers if primary fails (recommended: true)"
          },
          "repomix.openrouter.quantizations": {
            "order": 14,
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "fp8"
            ],
            "description": "⚡ \n Quantization preferences (e.g., [\"fp8\", \"fp16\"])"
          }
        }
      },
      {
        "title": "Background Indexing",
        "order": 8,
        "type": "object",
        "properties": {
          "repomix.backgroundIndexing.enabled": {
            "order": 1,
            "type": "boolean",
            "default": true,
            "description": "🔄 \n Enable automatic background re-indexing when files change. When disabled, you must manually re-index to update the vector database."
          },
          "repomix.backgroundIndexing.debounceMs": {
            "order": 2,
            "type": "number",
            "default": 2500,
            "minimum": 500,
            "maximum": 30000,
            "description": "⏱️ \n Debounce time in milliseconds before triggering re-indexing after file changes"
          }
        }
      },
      {
        "title": "Smart Agent",
        "order": 9,
        "type": "object",
        "properties": {}
      },
      {
        "title": "Chat",
        "order": 10,
        "type": "object",
        "properties": {
          "repomix.chat.postgresConnectionString": {
            "order": 0,
            "type": "string",
            "default": "",
            "description": "🐘 PostgreSQL connection string for chat storage (e.g., postgresql://user:pass@host:5432/dbname). If set, this takes precedence over the secret storage.",
            "scope": "machine-overridable"
          },
          "repomix.chat.contextThresholdPercent": {
            "order": 1,
            "type": "number",
            "default": 80,
            "minimum": 50,
            "maximum": 95,
            "description": "Percentage of context window that triggers automatic compression"
          },
          "repomix.chat.maxRecentMessages": {
            "order": 2,
            "type": "number",
            "default": 10,
            "minimum": 3,
            "maximum": 50,
            "description": "Number of recent messages to keep in full before summarizing older ones"
          },
          "repomix.chat.batchModel": {
            "order": 3,
            "type": "string",
            "default": "claude-opus-4-20250514",
            "description": "Anthropic model ID used for batch jobs"
          },
          "repomix.chat.batchMaxTokens": {
            "order": 4,
            "type": "number",
            "default": 16384,
            "minimum": 1024,
            "maximum": 64000,
            "description": "Maximum output tokens per Anthropic batch request"
          },
          "repomix.chat.batchThinkingBudget": {
            "order": 5,
            "type": "number",
            "default": 10000,
            "minimum": 0,
            "maximum": 32000,
            "description": "Extended thinking token budget for Anthropic batch requests"
          },
          "repomix.chat.batchPollIntervalSeconds": {
            "order": 6,
            "type": "number",
            "default": 60,
            "minimum": 10,
            "maximum": 600,
            "description": "Polling interval (seconds) while awaiting Anthropic batch completion"
          },
          "repomix.chat.batchSendAllLimit": {
            "order": 7,
            "type": "number",
            "default": 100,
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum number of approved packages submitted by one Send All action"
          },
          "repomix.chat.batchApiMaxRetries": {
            "order": 8,
            "type": "number",
            "default": 3,
            "minimum": 0,
            "maximum": 10,
            "description": "Retry attempts for transient Anthropic batch API failures"
          },
          "repomix.chat.batchApiRetryBaseMs": {
            "order": 9,
            "type": "number",
            "default": 1000,
            "minimum": 100,
            "maximum": 10000,
            "description": "Base delay in milliseconds for Anthropic batch API retry backoff"
          },
          "repomix.chat.batchApiRetryMaxMs": {
            "order": 10,
            "type": "number",
            "default": 8000,
            "minimum": 500,
            "maximum": 60000,
            "description": "Maximum delay in milliseconds for Anthropic batch API retry backoff"
          },
          "repomix.chat.architectureRefreshHours": {
            "order": 11,
            "type": "number",
            "default": 24,
            "minimum": 1,
            "maximum": 168,
            "description": "🏛️ How often (in hours) to regenerate the architecture document"
          },
          "repomix.chat.editMode": {
            "order": 12,
            "type": "string",
            "enum": [
              "full",
              "search_replace",
              "hybrid"
            ],
            "default": "hybrid",
            "description": "How to apply file edits: full file write, SEARCH/REPLACE patch, or auto-select based on file size"
          },
          "repomix.chat.hybridThresholdLines": {
            "order": 13,
            "type": "number",
            "default": 300,
            "minimum": 50,
            "maximum": 1000,
            "description": "Line count threshold for hybrid mode (files >= this use SEARCH/REPLACE)"
          },
          "repomix.chat.fuzzyMatchThreshold": {
            "order": 14,
            "type": "number",
            "minimum": 0.5,
            "maximum": 1,
            "default": 0.8,
            "description": "Similarity score threshold for fuzzy matching (0-1)"
          },
          "repomix.chat.planningModel": {
            "order": 15,
            "type": "string",
            "enum": [
              "gemini-2.5-flash",
              "gemini-2.5-flash-lite"
            ],
            "default": "gemini-2.5-flash",
            "description": "🧠 LLM model for planning and orchestration (Gemini Flash)"
          },
          "repomix.chat.planningRpm": {
            "order": 16,
            "type": "number",
            "default": 60,
            "minimum": 1,
            "maximum": 1000,
            "description": "🔄 Rate limit (requests per minute) for planning LLM"
          },
          "repomix.chat.fileCompressionLevel": {
            "order": 17,
            "type": "string",
            "enum": [
              "auto",
              "full",
              "skeleton",
              "summary"
            ],
            "default": "auto",
            "description": "🗜️ How to compress files in chat context (auto/full/skeleton/summary)"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repomix-sidebar",
          "title": "Repomix Control Panel",
          "icon": "assets/home.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "repomixBundles",
          "name": "REPOMIX"
        }
      ],
      "repomix-sidebar": [
        {
          "type": "webview",
          "id": "repomixRunner.controlPanel",
          "name": "Repomix Runner Control Panel"
        },
        {
          "type": "webview",
          "id": "repomixRunner.aiChatMain",
          "name": "AI Developer Chat",
          "icon": "assets/comment.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "repomixRunner.copySelectedFilesToClipboard",
        "title": "Copy as Markdown to Clipboard",
        "category": "Repomix"
      },
      {
        "command": "repomixRunner.copySelectedFilesAsCompressed",
        "title": "Copy as Compressed Repomix to Clipboard",
        "category": "Repomix"
      },
      {
        "command": "repomixRunner.editBundle",
        "title": "Repomix: Edit Bundle",
        "icon": "$(edit)"
      },
      {
        "command": "repomixRunner.goToConfigFile",
        "title": "Repomix: Go to Bundle Config File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "repomixRunner.removeSelectedFilesFromCustomViewToActiveBundle",
        "title": "Repomix: Remove Selection from Active Bundle",
        "icon": "$(trash)"
      },
      {
        "command": "repomixRunner.removeSelectedFilesFromActiveBundle",
        "title": "Repomix: Remove Selection from Active Bundle",
        "icon": "$(trash)"
      },
      {
        "command": "repomixRunner.addSelectedFilesToActiveBundle",
        "title": "Repomix: Add to Active Bundle",
        "icon": "$(plus)"
      },
      {
        "command": "repomixRunner.addSelectedFilesToNewBundle",
        "title": "Repomix: Create New Bundle with Selection",
        "icon": "$(plus)"
      },
      {
        "command": "repomixRunner.createBundle",
        "title": "Repomix: Create New Bundle",
        "icon": "$(plus)"
      },
      {
        "command": "repomixRunner.selectActiveBundle",
        "title": "Repomix: Select Active Bundle",
        "icon": "$(search)"
      },
      {
        "command": "repomixRunner.run",
        "title": "Repomix: Run",
        "description": "Run repomix on the root folder of your project",
        "icon": "assets/repomix-logo.svg"
      },
      {
        "command": "repomixRunner.runBundle",
        "title": "Repomix: Run Bundle",
        "icon": "$(play)"
      },
      {
        "command": "repomixRunner.deleteBundle",
        "title": "Repomix: Delete Bundle",
        "icon": "$(trash)",
        "enablement": "view == repomixBundles"
      },
      {
        "command": "repomixRunner.refreshBundles",
        "title": "Repomix: Refresh Bundles",
        "icon": "$(refresh)"
      },
      {
        "command": "repomixRunner.runOnSelectedFiles",
        "title": "Repomix: Run on Selection"
      },
      {
        "command": "repomixRunner.runOnOpenFiles",
        "title": "Repomix: Run On Open Files",
        "description": "Run repomix on the open files",
        "icon": "assets/file.svg"
      },
      {
        "command": "repomixRunner.openSettings",
        "title": "Repomix: Settings",
        "description": "Open Repomix Runner settings",
        "icon": "$(settings)"
      },
      {
        "command": "repomixRunner.openOutput",
        "title": "Repomix: Output",
        "description": "Open Repomix Runner output channel",
        "icon": "$(output)"
      },
      {
        "command": "repomixRunner.testCompression",
        "title": "Repomix: Test Compression",
        "description": "Compress the active JS/TS file using AST skeleton extraction",
        "icon": "$(symbol-class)"
      },
      {
        "command": "repomixRunner.removeFileFromBundle",
        "title": "Remove from Bundle",
        "icon": "$(trash)"
      },
      {
        "command": "repomixRunner.smartRun",
        "title": "Repomix: Smart Agent Run",
        "description": "Use AI to intelligently select and package files based on a natural language query",
        "icon": "$(sparkle)"
      },
      {
        "command": "repomixRunner.copyFromScm",
        "title": "Copy as Markdown to Clipboard",
        "category": "Repomix"
      },
      {
        "command": "repomixRunner.copyAllGitChanges",
        "title": "Copy All Changed Files to Clipboard",
        "icon": "$(copy)"
      },
      {
        "command": "repomixRunner.testPostgresConnection",
        "title": "Repomix: Test PostgreSQL Connection",
        "description": "Test the PostgreSQL connection and run migrations",
        "icon": "$(database)"
      },
      {
        "command": "repomixRunner.refreshArchitecture",
        "title": "Repomix: Refresh Repository Architecture",
        "description": "Manually trigger repository architecture generation",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "repomixRunner.createBundle",
          "title": "Repomix: Create New Bundle",
          "when": "view == repomixBundles",
          "group": "navigation@0"
        },
        {
          "command": "repomixRunner.run",
          "title": "Repomix Run",
          "group": "navigation@1",
          "when": "view == repomixBundles"
        },
        {
          "command": "repomixRunner.runOnOpenFiles",
          "title": "Repomix On Open Files",
          "group": "navigation",
          "when": "view == repomixBundles"
        },
        {
          "command": "repomixRunner.openSettings",
          "when": "view == repomixBundles",
          "group": "navigation@2",
          "icon": "$(settings)"
        },
        {
          "command": "repomixRunner.refreshBundles",
          "when": "view == repomixBundles",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "repomixRunner.runBundle",
          "when": "viewItem == bundle",
          "group": "inline@3"
        },
        {
          "command": "repomixRunner.editBundle",
          "when": "viewItem == bundle",
          "group": "inline@2"
        },
        {
          "command": "repomixRunner.goToConfigFile",
          "when": "viewItem == bundle",
          "group": "inline@1"
        },
        {
          "command": "repomixRunner.removeSelectedFilesFromCustomViewToActiveBundle",
          "when": "viewItem in activeBundleId",
          "group": "inline@4"
        },
        {
          "command": "repomixRunner.deleteBundle",
          "when": "viewItem == bundle",
          "group": "repomix@1"
        }
      ],
      "explorer/context": [
        {
          "command": "repomixRunner.copySelectedFilesToClipboard",
          "when": "explorerResourceIsFolder || !explorerResourceIsFolder",
          "group": "2_workspace"
        },
        {
          "command": "repomixRunner.copySelectedFilesAsCompressed",
          "when": "explorerResourceIsFolder || !explorerResourceIsFolder",
          "group": "2_workspace"
        },
        {
          "command": "repomixRunner.runOnSelectedFiles",
          "when": "explorerResourceIsFolder || resourceLangId",
          "group": "repomix@1"
        },
        {
          "command": "repomixRunner.addSelectedFilesToNewBundle",
          "when": "explorerResourceIsFolder || resourceLangId",
          "group": "repomix@2"
        },
        {
          "command": "repomixRunner.addSelectedFilesToActiveBundle",
          "when": "(explorerResourceIsFolder || resourceLangId) && activeBundleId",
          "group": "repomix@2"
        },
        {
          "command": "repomixRunner.removeSelectedFilesFromActiveBundle",
          "when": "(explorerResourceIsFolder || resourceLangId ) && activeBundleId",
          "group": "repomix@3"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "repomixRunner.copyFromScm",
          "group": "navigation@99",
          "when": "scmProvider == git"
        }
      ],
      "scm/title": [
        {
          "command": "repomixRunner.copyAllGitChanges",
          "group": "navigation@1",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "repomixRunner.selectActiveBundle",
          "when": "never"
        },
        {
          "command": "repomixRunner.goToConfigFile",
          "when": "never"
        },
        {
          "command": "repomixRunner.removeSelectedFilesFromActiveBundle",
          "when": "never"
        },
        {
          "command": "repomixRunner.removeSelectedFilesFromCustomViewToActiveBundle",
          "when": "never"
        },
        {
          "command": "repomixRunner.addSelectedFilesToActiveBundle",
          "when": "never"
        },
        {
          "command": "repomixRunner.addSelectedFilesToNewBundle",
          "when": "never"
        },
        {
          "command": "repomixRunner.runOnSelectedFiles",
          "when": "never"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "rimraf dist && node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "rimraf dist && npm run lint && node esbuild.js --production",
    "package:vsix": "node scripts/ensure-bin.mjs && vsce package --out bin/",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test:unit": "rimraf out-test; npm run compile-tests && NODE_PATH=out-test/test/shims mocha --ui tdd \"out-test/test/lanes/unit.entry.test.js\"; code=$?; rimraf out-test; exit $code",
    "test:integration": "rimraf out-test; npm run compile-tests && vscode-test; code=$?; rimraf out-test; exit $code",
    "test": "npm-run-all test:unit test:integration",
    "clean": "rimraf dist out",
    "chat:migrate:create": "node-pg-migrate create --migrations-dir src/chat/db/migrations --migration-file-language sql",
    "chat:migrate:up": "node-pg-migrate up --migrations-dir src/chat/db/migrations --migrations-table chat_schema_migrations --schema public --migrations-schema public",
    "chat:migrate:down": "node-pg-migrate down --migrations-dir src/chat/db/migrations --migrations-table chat_schema_migrations --schema public --migrations-schema public",
    "build:rust": "node scripts/build-rust.mjs",
    "setup:treesitter": "node scripts/setup-treesitter.mjs",
    "package:local": "node scripts/package-local.mjs",
    "test:compression": "ts-node src/test-compression.ts",
    "test:compression:js": "npm run compile && node dist/test-compression.js",
    "diagnose:compression": "node scripts/diagnose-compression.js",
    "test:enrichment": "tsx src/test-enrichment.ts",
    "enrich:repo": "ts-node scripts/enrich-repo.ts",
    "test:enrichment:index": "tsx src/test-enrichment-indexing.ts",
    "test:enrichment:retrieve": "tsx src/test-enrichment-retrieval.ts",
    "test:llm": "ts-node src/test-llm-connection.ts"
  },
