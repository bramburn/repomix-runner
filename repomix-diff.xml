HRC["humanReviewCode"]
GS["generateSummary"]
EM["extractMemory"]
end
GC --> PC --> HRG --> PP --> HAS --> SB --> ABR --> PBR --> HRE --> AE --> HRC --> GS --> EM
HRC --> |loop| PP
```

